[OPTIONS]
enable: 1
policy_in: DROP
policy_out: ACCEPT
policy_forward: ACCEPT
log_ratelimit: enable=1,rate=1/second,burst=5

[RULES]
# Public SSH fallback is allowed, but sshd itself is key-only.
IN SSH(ACCEPT) -log nolog

# Tailscale direct UDP; full tailnet traffic enters through tailscale0 below.
IN ACCEPT -p udp -dport 41641 -log nolog

# Do not expose Proxmox management surfaces on the public NIC, including
# Proxmox built-in local-management exceptions for the provider subnet.
IN DROP -i enp65s0f0 -p tcp -dport 8006 -log warning
IN DROP -i enp65s0f0 -p tcp -dport 5900:5999 -log warning
IN DROP -i enp65s0f0 -p tcp -dport 3128 -log warning
IN DROP -i enp65s0f0 -p tcp -dport 60000:60050 -log warning

# Permit all traffic arriving through Tailscale and the private VM bridge.
IN ACCEPT -i tailscale0 -log nolog
IN ACCEPT -i vmbr1 -log nolog

# Basic diagnostics.
IN ACCEPT -p icmp -log nolog
IN ACCEPT -p ipv6-icmp -log nolog
