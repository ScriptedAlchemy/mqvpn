# network interface settings; autogenerated
# Please do NOT modify this file directly, unless you know what
# you're doing.
#
# If you want to manage parts of the network configuration manually,
# please utilize the 'source' or 'source-directory' directives to do
# so.
# PVE will preserve these directives, but will NOT read its network
# configuration from sourced files, so do not attempt to move any of
# the PVE managed interfaces into external files!

source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback

iface lo inet6 loopback

auto enp65s0f0
iface enp65s0f0 inet static
	address 208.69.79.206/24
	gateway 208.69.79.1
	up route add -net 208.69.79.0 netmask 255.255.255.0 gw 208.69.79.1 dev enp65s0f0
# route 208.69.79.0/24 via 208.69.79.1

iface eth1 inet manual


auto vmbr1
iface vmbr1 inet static
	address 10.10.10.1/24
	bridge-ports none
	bridge-stp off
	bridge-fd 0
	# Codex vmbr1 NAT for private guests
	post-up iptables -t nat -C POSTROUTING -s 10.10.10.0/24 -o enp65s0f0 -j SNAT --to-source 208.69.79.206 || iptables -t nat -I POSTROUTING 1 -s 10.10.10.0/24 -o enp65s0f0 -j SNAT --to-source 208.69.79.206
	post-up iptables -C FORWARD -i vmbr1 -o enp65s0f0 -j ACCEPT || iptables -I FORWARD 1 -i vmbr1 -o enp65s0f0 -j ACCEPT
	post-up iptables -C FORWARD -i enp65s0f0 -o vmbr1 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT || iptables -I FORWARD 1 -i enp65s0f0 -o vmbr1 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
	# mqvpn CT 212: conntrack zone for its firewall bridge and public UDP forwarding
	post-up iptables -t raw -C PREROUTING -i fwbr212i0 -j CT --zone 1 || iptables -t raw -I PREROUTING 1 -i fwbr212i0 -j CT --zone 1
	post-up iptables -t nat -C PREROUTING -i enp65s0f0 -p udp --dport 443 -j DNAT --to-destination 10.10.10.212:443 || iptables -t nat -I PREROUTING 1 -i enp65s0f0 -p udp --dport 443 -j DNAT --to-destination 10.10.10.212:443
	post-up iptables -C FORWARD -i enp65s0f0 -o vmbr1 -p udp -d 10.10.10.212 --dport 443 -m conntrack --ctstate NEW -j ACCEPT || iptables -A FORWARD -i enp65s0f0 -o vmbr1 -p udp -d 10.10.10.212 --dport 443 -m conntrack --ctstate NEW -j ACCEPT
	post-down iptables -t nat -D POSTROUTING -s 10.10.10.0/24 -o enp65s0f0 -j SNAT --to-source 208.69.79.206 || true
	post-down iptables -D FORWARD -i vmbr1 -o enp65s0f0 -j ACCEPT || true
	post-down iptables -D FORWARD -i enp65s0f0 -o vmbr1 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT || true
	post-down iptables -t raw -D PREROUTING -i fwbr212i0 -j CT --zone 1 || true
	post-down iptables -t nat -D PREROUTING -i enp65s0f0 -p udp --dport 443 -j DNAT --to-destination 10.10.10.212:443 || true
	post-down iptables -D FORWARD -i enp65s0f0 -o vmbr1 -p udp -d 10.10.10.212 --dport 443 -m conntrack --ctstate NEW -j ACCEPT || true
# Private VM bridge. Guests are private on vmbr1; outbound internet is SNATed by the host for updates and Tailscale.
