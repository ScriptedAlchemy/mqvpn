[Unit]
Description=MQVPN tunnel-only ZeroFS service alias
Documentation=https://github.com/mp0rta/mqvpn
Requires=mqvpn-server.service
After=mqvpn-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -ec '/usr/sbin/iptables -t nat -C PREROUTING -i mqvpn0 -s 10.77.77.0/24 -d 10.77.77.55/32 -p tcp --dport 8080 -m comment --comment mqvpn-zerofs-alias -j DNAT --to-destination 10.10.10.55:8080 || /usr/sbin/iptables -t nat -I PREROUTING 1 -i mqvpn0 -s 10.77.77.0/24 -d 10.77.77.55/32 -p tcp --dport 8080 -m comment --comment mqvpn-zerofs-alias -j DNAT --to-destination 10.10.10.55:8080'
ExecStart=/bin/sh -ec '/usr/sbin/iptables -C FORWARD -i mqvpn0 -s 10.77.77.0/24 -d 10.10.10.55/32 -p tcp --dport 8080 -m conntrack --ctstate NEW,ESTABLISHED -m comment --comment mqvpn-zerofs-alias -j ACCEPT || /usr/sbin/iptables -I FORWARD 1 -i mqvpn0 -s 10.77.77.0/24 -d 10.10.10.55/32 -p tcp --dport 8080 -m conntrack --ctstate NEW,ESTABLISHED -m comment --comment mqvpn-zerofs-alias -j ACCEPT'
ExecStart=/bin/sh -ec '/usr/sbin/iptables -C FORWARD -i eth0 -s 10.10.10.55/32 -d 10.77.77.0/24 -p tcp --sport 8080 -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment mqvpn-zerofs-alias -j ACCEPT || /usr/sbin/iptables -I FORWARD 1 -i eth0 -s 10.10.10.55/32 -d 10.77.77.0/24 -p tcp --sport 8080 -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment mqvpn-zerofs-alias -j ACCEPT'
ExecStop=/bin/sh -c '/usr/sbin/iptables -t nat -D PREROUTING -i mqvpn0 -s 10.77.77.0/24 -d 10.77.77.55/32 -p tcp --dport 8080 -m comment --comment mqvpn-zerofs-alias -j DNAT --to-destination 10.10.10.55:8080 2>/dev/null || true; /usr/sbin/iptables -D FORWARD -i mqvpn0 -s 10.77.77.0/24 -d 10.10.10.55/32 -p tcp --dport 8080 -m conntrack --ctstate NEW,ESTABLISHED -m comment --comment mqvpn-zerofs-alias -j ACCEPT 2>/dev/null || true; /usr/sbin/iptables -D FORWARD -i eth0 -s 10.10.10.55/32 -d 10.77.77.0/24 -p tcp --sport 8080 -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment mqvpn-zerofs-alias -j ACCEPT 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
